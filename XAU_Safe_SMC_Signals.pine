//@version=6
// ============================================================================
//  XAU Safe SMC Signals  –  Liquidity Sweep + MSS + Fair Value Gap + Price Action
//  Für Gold (XAUUSD) optimiert, funktioniert aber auf jedem Symbol.
//
//  Logik eines BUY-Signals (SELL spiegelbildlich):
//   1. Liquidity Sweep: Kerze sticht unter ein bestätigtes Swing-Low (Sell-Side
//      Liquidity) und schließt wieder darüber  -> Stop-Hunt.
//   2. Market Structure Shift (MSS): Danach schließt eine Kerze über dem letzten
//      internen Swing-High  -> Smart Money dreht.
//   3. Fair Value Gap: Nach dem Sweep entsteht ein bullisches FVG (Displacement).
//   4. Retest: Preis läuft zurück ins FVG und hält dessen Unterkante.
//   5. Price Action: Bullische Bestätigungskerze (Rejection-Wick oder Engulfing).
//   6. Filter: HTF-Trend, EMA-Trend, Session (London/NY), News-Spike, max. SL.
//  Signale erscheinen erst nach Kerzenschluss  -> kein Repainting.
//
//  Kein Indikator ist 100 % sicher. Immer mit Stop-Loss und kleinem Risiko traden.
// ============================================================================
indicator("XAU Safe SMC Signals [Sweep + FVG + PA]", shorttitle = "XAU Safe SMC", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
grpS       = "Struktur / Liquidity"
swingLen   = input.int(10, "Swing-Länge (Liquidity-Pools)", minval = 2, group = grpS)
intLen     = input.int(3, "Interne Swing-Länge (MSS)", minval = 1, group = grpS)
sweepValid = input.int(30, "Setup gültig max. Bars nach Sweep", minval = 3, group = grpS)
reqMSS     = input.bool(true, "Market Structure Shift erforderlich", group = grpS)

grpF       = "Fair Value Gaps"
fvgMinAtr  = input.float(0.15, "Min. FVG-Größe (x ATR)", minval = 0.0, step = 0.05, group = grpF)
fvgValid   = input.int(15, "FVG-Retest gültig max. Bars", minval = 2, group = grpF)
showFvg    = input.bool(true, "FVG-Zonen anzeigen", group = grpF)

grpT       = "Trend-Filter"
useHtf     = input.bool(true, "HTF-Trendfilter", group = grpT)
htfTf      = input.timeframe("60", "HTF-Timeframe", group = grpT)
htfLen     = input.int(200, "HTF-EMA Länge", minval = 1, group = grpT)
useEma     = input.bool(true, "Chart-EMA-Filter (EMA 50 > / < EMA 200)", group = grpT)
showEma    = input.bool(true, "EMAs anzeigen", group = grpT)

grpSe      = "Session-Filter"
useSess    = input.bool(true, "Nur London / New York handeln", group = grpSe)
sessLon    = input.session("0800-1130", "London", group = grpSe)
sessNy     = input.session("1430-1800", "New York", group = grpSe)
tz         = input.string("Europe/Berlin", "Zeitzone", group = grpSe)

grpR       = "Risiko-Management"
atrLen     = input.int(14, "ATR-Länge", minval = 1, group = grpR)
slBufAtr   = input.float(0.25, "SL-Puffer hinter Sweep (x ATR)", minval = 0.0, step = 0.05, group = grpR)
rr1        = input.float(1.0, "TP1 (R-Multiple)", minval = 0.25, step = 0.25, group = grpR)
rr2        = input.float(2.5, "TP2 (R-Multiple)", minval = 0.5, step = 0.25, group = grpR)
maxSlAtr   = input.float(3.0, "Max. SL-Distanz (x ATR) – sonst kein Trade", minval = 0.5, step = 0.25, group = grpR)
spikeAtr   = input.float(3.0, "News-Spike-Filter: Kerze > x ATR blockiert", minval = 1.0, step = 0.25, group = grpR)
oneTrade   = input.bool(true, "Nur ein Trade gleichzeitig", group = grpR)
beAfterTp1 = input.bool(true, "SL nach TP1 auf Break-Even", group = grpR)

grpV       = "Anzeige"
showLevels = input.bool(true, "Entry / SL / TP Linien", group = grpV)
showSweeps = input.bool(true, "Liquidity-Sweeps markieren", group = grpV)
showStats  = input.bool(true, "Statistik-Tabelle", group = grpV)

colBull = color.new(#00c853, 0)
colBear = color.new(#ff1744, 0)

// ───────────────────────────── Basis ─────────────────────────────
atr    = ta.atr(atrLen)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rng    = high - low

// Nicht-repaintender HTF-Trend (abgeschlossene HTF-Kerze)
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1], lookahead = barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, htfTf, close[1], lookahead = barmerge.lookahead_on)

trendUp = (not useHtf or htfClose > htfEma) and (not useEma or ema50 > ema200)
trendDn = (not useHtf or htfClose < htfEma) and (not useEma or ema50 < ema200)

inSess(string s) =>
    not na(time(timeframe.period, s, tz))
sessOk  = not useSess or inSess(sessLon) or inSess(sessNy)
spikeOk = rng <= spikeAtr * atr

// ───────────────────────────── Swings / Liquidity ─────────────────────────────
ph  = ta.pivothigh(high, swingLen, swingLen)
pl  = ta.pivotlow(low, swingLen, swingLen)
iph = ta.pivothigh(high, intLen, intLen)
ipl = ta.pivotlow(low, intLen, intLen)

var float swingHigh    = na
var int   swingHighBar = na
var float swingLow     = na
var int   swingLowBar  = na
var float intHigh      = na
var float intLow       = na

if not na(ph)
    swingHigh    := ph
    swingHighBar := bar_index - swingLen
if not na(pl)
    swingLow     := pl
    swingLowBar  := bar_index - swingLen
if not na(iph)
    intHigh := iph
if not na(ipl)
    intLow := ipl

bullSweep = not na(swingLow) and low < swingLow and close > swingLow
bearSweep = not na(swingHigh) and high > swingHigh and close < swingHigh

// ───────────────────────────── Setup-Status ─────────────────────────────
// Long-Setup
var int   bSweepBar = na
var float bSweepLow = na
var float bMssLvl   = na
var bool  bMss      = false
var float bFvgTop   = na
var float bFvgBot   = na
var int   bFvgBar   = na
// Short-Setup
var int   sSweepBar  = na
var float sSweepHigh = na
var float sMssLvl    = na
var bool  sMss       = false
var float sFvgTop    = na
var float sFvgBot    = na
var int   sFvgBar    = na

// --- Neuer Sweep ---
if bullSweep
    if showSweeps
        line.new(swingLowBar, swingLow, bar_index, swingLow, color = color.new(colBull, 30), style = line.style_dashed)
        label.new(bar_index, low, "$$$ Sweep", style = label.style_label_up, color = color.new(colBull, 70), textcolor = color.white, size = size.tiny)
    bSweepBar := bar_index
    bSweepLow := low
    bMssLvl   := na(intHigh) ? high : math.max(intHigh, high)
    bMss      := false
    bFvgTop   := na
    bFvgBot   := na
    bFvgBar   := na
    swingLow  := na   // Liquidität verbraucht

if bearSweep
    if showSweeps
        line.new(swingHighBar, swingHigh, bar_index, swingHigh, color = color.new(colBear, 30), style = line.style_dashed)
        label.new(bar_index, high, "$$$ Sweep", style = label.style_label_down, color = color.new(colBear, 70), textcolor = color.white, size = size.tiny)
    sSweepBar  := bar_index
    sSweepHigh := high
    sMssLvl    := na(intLow) ? low : math.min(intLow, low)
    sMss       := false
    sFvgTop    := na
    sFvgBot    := na
    sFvgBar    := na
    swingHigh  := na

// --- Long-Setup pflegen ---
if not na(bSweepBar) and bar_index > bSweepBar
    if close < bSweepLow or bar_index - bSweepBar > sweepValid
        bSweepBar := na                         // invalidiert / abgelaufen
    else
        if low < bSweepLow
            bSweepLow := low                    // tieferer Wick, Struktur hält
        if not bMss and close > bMssLvl
            bMss := true
        bullFvg = low > high[2] and (low - high[2]) >= fvgMinAtr * atr and close[1] > open[1] and bar_index - 2 >= bSweepBar
        if bullFvg
            bFvgTop := low
            bFvgBot := high[2]
            bFvgBar := bar_index
            if showFvg
                box.new(bar_index - 2, bFvgTop, bar_index + fvgValid, bFvgBot, border_color = color.new(colBull, 60), bgcolor = color.new(colBull, 85))

// --- Short-Setup pflegen ---
if not na(sSweepBar) and bar_index > sSweepBar
    if close > sSweepHigh or bar_index - sSweepBar > sweepValid
        sSweepBar := na
    else
        if high > sSweepHigh
            sSweepHigh := high
        if not sMss and close < sMssLvl
            sMss := true
        bearFvg = high < low[2] and (low[2] - high) >= fvgMinAtr * atr and close[1] < open[1] and bar_index - 2 >= sSweepBar
        if bearFvg
            sFvgTop := low[2]
            sFvgBot := high
            sFvgBar := bar_index
            if showFvg
                box.new(bar_index - 2, sFvgTop, bar_index + fvgValid, sFvgBot, border_color = color.new(colBear, 60), bgcolor = color.new(colBear, 85))

// ───────────────────────────── Price Action ─────────────────────────────
bodyLow  = math.min(open, close)
bodyHigh = math.max(open, close)
bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bullReject = close > open and (bodyLow - low) >= 0.35 * rng and close >= low + 0.6 * rng
bearReject = close < open and (high - bodyHigh) >= 0.35 * rng and close <= high - 0.6 * rng
bullPA = rng > 0 and (bullEngulf or bullReject)
bearPA = rng > 0 and (bearEngulf or bearReject)

// ───────────────────────────── Trade-Tracking ─────────────────────────────
var int   tDir   = 0
var int   tBar   = na
var float tEntry = na
var float tSL    = na
var float tTP1   = na
var float tTP2   = na
var bool  tp1Hit = false
var int   nTrades = 0
var int   nTp1    = 0
var int   nTp2    = 0
var int   nSL     = 0
var int   nBE     = 0

// Offenen Trade managen (konservativ: SL wird vor TP geprüft)
if tDir != 0 and bar_index > tBar
    if tDir == 1
        if low <= tSL
            if tp1Hit
                nBE += 1
                label.new(bar_index, tSL, "BE", style = label.style_label_up, color = color.gray, textcolor = color.white, size = size.tiny)
            else
                nSL += 1
                label.new(bar_index, tSL, "SL ✗", style = label.style_label_up, color = colBear, textcolor = color.white, size = size.tiny)
            tDir := 0
        else if high >= tTP2
            nTp2 += 1
            if not tp1Hit
                nTp1 += 1
            label.new(bar_index, tTP2, "TP2 ✓", style = label.style_label_down, color = colBull, textcolor = color.white, size = size.tiny)
            tDir := 0
        else if not tp1Hit and high >= tTP1
            tp1Hit := true
            nTp1 += 1
            label.new(bar_index, tTP1, "TP1 ✓", style = label.style_label_down, color = color.new(colBull, 30), textcolor = color.white, size = size.tiny)
            if beAfterTp1
                tSL := tEntry
    else
        if high >= tSL
            if tp1Hit
                nBE += 1
                label.new(bar_index, tSL, "BE", style = label.style_label_down, color = color.gray, textcolor = color.white, size = size.tiny)
            else
                nSL += 1
                label.new(bar_index, tSL, "SL ✗", style = label.style_label_down, color = colBear, textcolor = color.white, size = size.tiny)
            tDir := 0
        else if low <= tTP2
            nTp2 += 1
            if not tp1Hit
                nTp1 += 1
            label.new(bar_index, tTP2, "TP2 ✓", style = label.style_label_up, color = colBull, textcolor = color.white, size = size.tiny)
            tDir := 0
        else if not tp1Hit and low <= tTP1
            tp1Hit := true
            nTp1 += 1
            label.new(bar_index, tTP1, "TP1 ✓", style = label.style_label_up, color = color.new(colBull, 30), textcolor = color.white, size = size.tiny)
            if beAfterTp1
                tSL := tEntry

flat = not oneTrade or tDir == 0

// ───────────────────────────── Signale ─────────────────────────────
longSL  = bSweepLow - slBufAtr * atr
shortSL = sSweepHigh + slBufAtr * atr

buySignal = barstate.isconfirmed and flat and sessOk and spikeOk and trendUp
     and not na(bSweepBar) and not na(bFvgBar)
     and (bMss or not reqMSS)
     and bar_index > bFvgBar and bar_index - bFvgBar <= fvgValid
     and low <= bFvgTop and close > bFvgBot
     and bullPA
     and close - longSL > 0 and close - longSL <= maxSlAtr * atr

sellSignal = barstate.isconfirmed and flat and sessOk and spikeOk and trendDn
     and not na(sSweepBar) and not na(sFvgBar)
     and (sMss or not reqMSS)
     and bar_index > sFvgBar and bar_index - sFvgBar <= fvgValid
     and high >= sFvgBot and close < sFvgTop
     and bearPA
     and shortSL - close > 0 and shortSL - close <= maxSlAtr * atr

// Falls beide gleichzeitig: keinen Trade (unklare Lage = sicherer)
if buySignal and sellSignal
    buySignal  := false
    sellSignal := false

drawLevels(float entry, float sl, float tp1, float tp2) =>
    if showLevels
        line.new(bar_index, entry, bar_index + 20, entry, color = color.blue, width = 2)
        line.new(bar_index, sl, bar_index + 20, sl, color = colBear, style = line.style_dashed)
        line.new(bar_index, tp1, bar_index + 20, tp1, color = color.new(colBull, 40), style = line.style_dashed)
        line.new(bar_index, tp2, bar_index + 20, tp2, color = colBull, style = line.style_dashed)
        label.new(bar_index + 20, sl, "SL " + str.tostring(sl, format.mintick), style = label.style_label_left, color = color.new(colBear, 80), textcolor = colBear, size = size.tiny)
        label.new(bar_index + 20, tp1, "TP1 " + str.tostring(tp1, format.mintick), style = label.style_label_left, color = color.new(colBull, 80), textcolor = colBull, size = size.tiny)
        label.new(bar_index + 20, tp2, "TP2 " + str.tostring(tp2, format.mintick), style = label.style_label_left, color = color.new(colBull, 80), textcolor = colBull, size = size.tiny)

if buySignal
    risk = close - longSL
    tDir := 1
    tBar := bar_index
    tEntry := close
    tSL := longSL
    tTP1 := close + rr1 * risk
    tTP2 := close + rr2 * risk
    tp1Hit := false
    nTrades += 1
    bSweepBar := na
    label.new(bar_index, low, "BUY\n" + str.tostring(close, format.mintick), style = label.style_label_up, color = colBull, textcolor = color.white, size = size.normal, yloc = yloc.belowbar)
    drawLevels(tEntry, tSL, tTP1, tTP2)
    alert("XAU BUY @ " + str.tostring(tEntry, format.mintick) + " | SL " + str.tostring(tSL, format.mintick) + " | TP1 " + str.tostring(tTP1, format.mintick) + " | TP2 " + str.tostring(tTP2, format.mintick), alert.freq_once_per_bar_close)

if sellSignal
    risk = shortSL - close
    tDir := -1
    tBar := bar_index
    tEntry := close
    tSL := shortSL
    tTP1 := close - rr1 * risk
    tTP2 := close - rr2 * risk
    tp1Hit := false
    nTrades += 1
    sSweepBar := na
    label.new(bar_index, high, "SELL\n" + str.tostring(close, format.mintick), style = label.style_label_down, color = colBear, textcolor = color.white, size = size.normal, yloc = yloc.abovebar)
    drawLevels(tEntry, tSL, tTP1, tTP2)
    alert("XAU SELL @ " + str.tostring(tEntry, format.mintick) + " | SL " + str.tostring(tSL, format.mintick) + " | TP1 " + str.tostring(tTP1, format.mintick) + " | TP2 " + str.tostring(tTP2, format.mintick), alert.freq_once_per_bar_close)

alertcondition(buySignal, "XAU BUY", "XAU Safe SMC: BUY-Signal")
alertcondition(sellSignal, "XAU SELL", "XAU Safe SMC: SELL-Signal")

// ───────────────────────────── Plots ─────────────────────────────
plot(showEma ? ema50 : na, "EMA 50", color = color.new(color.orange, 30))
plot(showEma ? ema200 : na, "EMA 200", color = color.new(color.purple, 20), linewidth = 2)
plot(useHtf ? htfEma : na, "HTF EMA", color = color.new(color.gray, 20), style = plot.style_stepline)
bgcolor(useSess and sessOk ? color.new(color.yellow, 94) : na, title = "Session")

// ───────────────────────────── Statistik ─────────────────────────────
var table stats = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if showStats and barstate.islast
    closed  = nTp2 + nSL + nBE
    winRate = closed > 0 ? 100.0 * (closed - nSL) / closed : 0.0
    table.cell(stats, 0, 0, "XAU Safe SMC", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 0, tDir == 1 ? "LONG offen" : tDir == -1 ? "SHORT offen" : "flat", text_color = tDir == 1 ? colBull : tDir == -1 ? colBear : color.gray, text_size = size.small)
    table.cell(stats, 0, 1, "Signale", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(nTrades), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 2, "TP1 erreicht", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(nTp1), text_color = colBull, text_size = size.small)
    table.cell(stats, 0, 3, "TP2 erreicht", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(nTp2), text_color = colBull, text_size = size.small)
    table.cell(stats, 0, 4, "SL / BE", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 4, str.tostring(nSL) + " / " + str.tostring(nBE), text_color = colBear, text_size = size.small)
    table.cell(stats, 0, 5, "Trefferquote (kein SL)", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 5, str.tostring(winRate, "#.#") + " %", text_color = color.white, text_size = size.small)
